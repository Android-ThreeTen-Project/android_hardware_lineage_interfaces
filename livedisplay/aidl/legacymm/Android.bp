cc_binary {
    name: "vendor.lineage.livedisplay-service.legacymm",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.livedisplay-service.legacymm.rc"],
    vintf_fragments: [
        "vendor.lineage.livedisplay-service.legacymm-dm.xml",
        "vendor.lineage.livedisplay-service.legacymm-pa.xml",
    ],
    srcs: ["DisplayModes.cpp", "PictureAdjustment.cpp", "service.cpp"],
    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "libdl",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
}
